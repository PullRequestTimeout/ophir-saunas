# Supabase (Project Settings → API Keys)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated emails allowed into /admin (accounts are created in the Supabase dashboard)
ADMIN_EMAILS=info@ophirsaunas.ca

# Resend (domain ophirsaunas.ca must be verified)
RESEND_API_KEY=re_...
EMAIL_FROM="Ophir Mobile Saunas <bookings@ophirsaunas.ca>"

# Shared secret for the scheduled reminders function
CRON_SECRET=generate-a-long-random-string

PUBLIC_SITE_URL=https://ophirsaunas.ca
